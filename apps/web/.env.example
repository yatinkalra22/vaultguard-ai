# ======================
# VaultGuard AI — Frontend (Next.js)
# ======================
# Copy this file to: apps/web/.env.local
# Setup guide: docs/FRONTEND_ENV_SETUP.md

# ── Auth0 ─────────────────────────────────────────────────
AUTH0_SECRET=              # Generate with: openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=     # https://YOUR_TENANT.us.auth0.com
AUTH0_DOMAIN=              # YOUR_TENANT.us.auth0.com (without https://)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.vaultguard.ai
AUTH0_ORGANIZATION_ID=

# ── Backend API ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
