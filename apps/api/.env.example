# ======================
# VaultGuard AI — Backend (NestJS)
# ======================
# Copy this file to: apps/api/.env
# Setup guide: docs/BACKEND_ENV_SETUP.md

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth0 ─────────────────────────────────────────────────
AUTH0_DOMAIN=              # YOUR_TENANT.us.auth0.com
AUTH0_AUDIENCE=https://api.vaultguard.ai

# ── Auth0 AI (Token Vault + CIBA) ─────────────────────────
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_WEB_CLIENT_ID=       # Optional: VaultGuard Web client ID for /authorize integration flow
AUTH0_CONNECTION_SLACK=slack               # Custom social connection using Slack OAuth v2
AUTH0_CONNECTION_GITHUB=github
AUTH0_CONNECTION_SCOPE_SLACK=users:read,users:read.email,team:read,channels:read
AUTH0_CONNECTION_SCOPE_GITHUB=read:org,read:user,repo,read:audit_log,admin:org

# ── Auth0 FGA ─────────────────────────────────────────────
FGA_STORE_ID=
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=              # https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──────────────────────────────────────────
# Gemini is primary. Anthropic is secondary fallback.
# At least one key should be set for AI-enriched scan results.
GEMINI_API_KEY=            # AIza... (Google AI Studio → https://aistudio.google.com/apikey)
ANTHROPIC_API_KEY=         # sk-ant-... (secondary fallback)

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
AUTH0_BASE_URL=http://localhost:3000

# ── Optional ──────────────────────────────────────────────
DEFAULT_GITHUB_ORG=        # Fallback GitHub org for scheduled/manual scans
AUTH0_ORGANIZATION_ID=     # Optional fallback when JWT org_id is missing (local/dev)
